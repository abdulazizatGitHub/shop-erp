{
  "name": "@shop/server",
  "version": "0.1.0",
  "description": "Shop ERP — Electron main process (desktop shell)",
  "author": "Shop ERP",
  "private": true,
  "type": "module",
  "main": "dist/main/main.cjs",
  "scripts": {
    "rebuild": "cd ../.. && electron-rebuild -f -w better-sqlite3",
    "dev": "npm run rebuild && electron-vite dev",
    "build": "electron-vite build",
    "package": "npm run rebuild && electron-vite build && electron-builder --win --publish never"
  },
  "build": {
    "appId": "com.shoperp.desktop",
    "productName": "Shop ERP",
    "electronVersion": "33.4.11",
    "npmRebuild": false,
    "directories": {
      "output": "../../release"
    },
    "files": [
      "dist/**/*"
    ],
    "extraResources": [
      {
        "from": "../../packages/db/src/migrations",
        "to": "migrations",
        "filter": [
          "*.sql"
        ]
      }
    ],
    "win": {
      "target": "nsis",
      "signAndEditExecutable": false
    },
    "forceCodeSigning": false
  },
  "dependencies": {
    "@shop/contracts": "*",
    "@shop/core": "*",
    "@shop/db": "*",
    "@shop/shared": "*",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.0",
    "electron-vite": "^2.3.0"
  }
}
