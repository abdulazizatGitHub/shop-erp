# Copy to .env and adjust. NEVER commit .env.
NODE_ENV=development

# Absolute path to the SQLite database file.
# Leave blank in production — the app resolves the OS app-data directory.
DATABASE_PATH=./data/shop-dev.db

# Tenant identity (constant in local mode, see CLAUDE.md 3.5)
TENANT_ID=00000000-0000-0000-0000-000000000001

# Device code for document numbering (INV-A-000123). One letter per install.
DEVICE_CODE=A

# Logging
LOG_LEVEL=debug
LOG_DIR=./logs

# Backup
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=30

# --- NOT USED YET (future phases) ---
# CLOUD_SYNC_ENABLED=false
# CLOUD_API_URL=
# FBR_ENABLED=false
